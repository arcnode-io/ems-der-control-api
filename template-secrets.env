POSTGRES_PASSWORD=your_postgres_password_here

# broker File-RBAC identity for this service (platform-api credentials.reference.xml,
# role der_control_api — PUBLISH sites/+/devices/der_dispatch/measurements/#)
MQTT_DER_CONTROL_API_PASSWORD=broker-file-rbac-pw-for-arcnode-der-control-api
# The HMI's bearer tokens are signed by device-api with this secret; GET /events verifies them
# with the same one. Same value in both services' environments — the launcher's secrets.env
# already carries it for device-api. At least 32 bytes (HS256).
AUTH_JWT_SECRET=same-value-as-device-api-at-least-32-bytes

# The LFDIs (IEEE 2030.5 device identifiers: first 20 bytes of SHA-256 over the cert's DER, hex)
# allowed to POST DERControls. The ingress truststore is CA-level trust; this is the per-site list on
# top of it. Comma or whitespace separated, any case. Empty refuses every caller. Cloud: filled from
# the der-control-lfdi-allowlist secret beside the truststore, in the same ops step; restart to apply.
DER_CONTROL_LFDI_ALLOWLIST=0123456789abcdef0123456789abcdef01234567

# beta/cloud only. libpq URL for this service's own Aurora slice, provisioned by platform-api.
# Overrides POSTGRES_PASSWORD + spring.datasource.* (DataSourceUrl.Loader). Unset locally —
# local dev connects via postgresHost/POSTGRES_PASSWORD instead.
DER_CONTROL_URL=postgres://user:password@host:5432/ems_dercontrol

# Optional — speeds up `make audit-packages` (OWASP dependency-check) past NVD's public rate
# limit. Free signup: https://nvd.nist.gov/developers/request-an-api-key
# Read automatically from this env var (nvdApiKeyEnvironmentVariable in pom.xml) — no CLI flag needed.
NVD_API_KEY=

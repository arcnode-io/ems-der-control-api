<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Spring beans expose their injected collaborators by design; EI_EXPOSE_REP noise. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- JPA entities need mutable fields. -->
  <Match>
    <Class name="~.*\.DerEvent"/>
  </Match>
  <!-- JAXB-generated IEEE 2030.5 classes (src/main/resources/xsd/sep.xsd) aren't our code. -->
  <Match>
    <Class name="~io\.arcnode\.dercontrol\.mirror\.ieee20305\..*"/>
  </Match>
</FindBugsFilter>
